# THE-HK Cloud Functions Environment
# These values are loaded by the Firebase Functions runtime. Never commit the
# real .env file; this example is safe to keep in git.

APP_ENV=development

# Payment providers
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_SECRET=whsec_...
PAYSTACK_CALLBACK_URL=https://thehk.vercel.app/payment-success
KORAPAY_SECRET_KEY=...
KORAPAY_PUBLIC_KEY=...
KORAPAY_WEBHOOK_SECRET=...

# Social media growth
OWLET_API_KEY=...
OWLET_API_URL=https://the-owlet.com/api/v2

# Airtime/Data provider routing: vtung | reloadly | owlet
AIRTIME_DATA_PROVIDER=vtung
DATA_PROVIDER=vtung

# Bill provider routing: reloadly
BILL_PROVIDER=reloadly

# Reloadly (airtime, data, gift cards, bills)
RELOADLY_CLIENT_ID=...
RELOADLY_CLIENT_SECRET=...
RELOADLY_SANDBOX=true

# VTU.ng (airtime, data)
VTUNG_USERNAME=your_vtu_email_or_username
VTUNG_PASSWORD=your_vtu_password
VTUNG_USER_PIN=your_vtu_webhook_pin
VTUNG_API_BASE_URL=https://vtu.ng/wp-json/api/v2
