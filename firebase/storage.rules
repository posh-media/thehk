rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    match /listings/{sellerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == sellerId || isAdmin());
    }

    match /receipts/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Only Cloud Functions generate receipts
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
